// Code signing for Glass Act Host and Glass Act Viewer.
//
// The defaults build for anyone. To sign with your own Apple developer
// account, create Signing.local.xcconfig next to this file (git-ignored):
//
//   DEVELOPMENT_TEAM = ABCDE12345
//   GLASSACT_BUNDLE_PREFIX = com.example.glassact
//
// If you set your own DEVELOPMENT_TEAM, set your own GLASSACT_BUNDLE_PREFIX
// too: the default `app.glassact` is registered to the project owner's team,
// so signing app.glassact.host or app.glassact.viewer with any other team
// fails. macOS ties Screen Recording and Device Control grants to the bundle
// ID and team, so keep both stable once you've granted them. Apps/release.sh
// reads both from these files too.

DEVELOPMENT_TEAM =
GLASSACT_BUNDLE_PREFIX = app.glassact

#include? "Signing.local.xcconfig"

// Keys in the keychain (DESIGN §13): each app's own keychain access group.
// That entitlement needs a provisioning profile, which only a build with a
// team gets (Xcode's automatic signing makes it). Without a team the apps
// sign ad hoc with no entitlements and keep their keys in files instead.
GLASSACT_ENTITLEMENTS_NONE = Shared/NoEntitlements.entitlements
CODE_SIGN_ENTITLEMENTS = $(GLASSACT_ENTITLEMENTS_$(DEVELOPMENT_TEAM:default=NONE):default=Shared/Keychain.entitlements)
