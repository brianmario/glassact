<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>GlassActCommit</key>
	<string>$(GLASSACT_COMMIT)</string>
	<!-- Encryption: only the system's (TLS 1.3 in Network.framework,
	     CryptoKit signatures), which is exempt from export documentation. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSBonjourServices</key>
	<array>
		<string>_glassact._udp</string>
	</array>
</dict>
</plist>
