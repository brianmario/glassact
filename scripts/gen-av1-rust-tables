#!/usr/bin/env python3
"""Generates rust/av1/src/tables/{spec.rs,consts.rs} from the C tables the Metal kernels use.

The GPU kernels compile the C headers in Sources/GlassActAV1/Shaders/av1g (spec tables, default
CDFs, libaom's quantizer tables, levels and constants); the Rust CPU code must use the same values.
This compiles a dumper against those headers with clang++, so the C compiler, not a parser here,
decides what every initializer means, and writes the values out as Rust arrays of the same shape.

Run it after changing a table header; `cargo test` checks the committed output is current.
"""
import os, re, subprocess, sys, tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
INC = [os.path.join(ROOT, p) for p in ("Sources/GlassActAV1/Shaders", "Sources/AV1Core/include", "Sources/AV1Encoder/include")]
HEADERS = ["av1g/spec_tables.h", "av1g/cdf_defaults.h", "av1f/aom_tables_gen.h"]
OUT = os.path.join(ROOT, "rust/av1/src/tables")
RUST_T = {"uint8_t": "u8", "int8_t": "i8", "uint16_t": "u16", "int16_t": "i16", "uint32_t": "u32",
          "int32_t": "i32", "int": "i32"}

def find(path):
    for d in INC:
        p = os.path.join(d, path)
        if os.path.exists(p):
            return p
    sys.exit(f"gen-av1-rust-tables: {path} not found under {INC}")

def tables():
    out = []
    for h in HEADERS:
        text = open(find(h)).read()
        for m in re.finditer(r"AV1G_TABLE\(\s*([a-z0-9_]+)\s*,\s*([A-Za-z_0-9]+)\s*,\s*((?:\[\d+\])+)\s*,", text):
            out.append((m.group(1), m.group(2), [int(d) for d in re.findall(r"\[(\d+)\]", m.group(3))]))
    return out

def dump(tabs):
    src = ["#include <stdio.h>", "#include <stdint.h>"] + [f'#include "{h}"' for h in HEADERS] + ["#include \"av1g/levels_gen.h\"", "int main() {"]
    for t, name, dims in tabs:
        n = 1
        for d in dims: n *= d
        src.append(f'  {{ const {t} *p = (const {t} *)&{name}_host; printf("T {name}"); '
                   f'for (int i = 0; i < {n}; i++) printf(" %lld", (long long)p[i]); printf("\\n"); }}')
    src.append('  { const uint32_t *p = &av1g_levels[0][0]; printf("T av1g_levels"); for (int i = 0; i < 14 * 6; i++) printf(" %u", p[i]); printf("\\n"); }')
    src.append("  return 0; }")
    with tempfile.TemporaryDirectory() as tmp:
        c = os.path.join(tmp, "dump.cpp"); exe = os.path.join(tmp, "dump")
        open(c, "w").write("\n".join(src))
        subprocess.check_call(["xcrun", "clang++", "-std=c++17", "-w"] + [f"-I{d}" for d in INC] + [c, "-o", exe])
        lines = subprocess.check_output([exe]).decode().splitlines()
    vals = {}
    for ln in lines:
        parts = ln.split()
        vals[parts[1]] = [int(v) for v in parts[2:]]
    return vals

def nest(v, dims):
    if len(dims) == 1:
        return "[" + ", ".join(str(x) for x in v) + "]"
    step = len(v) // dims[0]
    return "[" + ", ".join(nest(v[i * step:(i + 1) * step], dims[1:]) for i in range(dims[0])) + "]"

def rust_type(t, dims):
    s = RUST_T[t]
    for d in reversed(dims):
        s = f"[{s}; {d}]"
    return s

HEADER = "// GENERATED by scripts/gen-av1-rust-tables from the C table headers the Metal kernels share. DO NOT EDIT.\n"

def main():
    tabs = tables()
    vals = dump(tabs)
    gen = [HEADER, "#![allow(non_upper_case_globals, clippy::all)]\n"]
    for t, name, dims in tabs:
        gen.append(f"pub static {name}: {rust_type(t, dims)} = {nest(vals[name], dims)};\n")
    gen.append(f"pub static av1g_levels: [[u32; 6]; 14] = {nest(vals['av1g_levels'], [14, 6])};\n")
    open(os.path.join(OUT, "spec.rs"), "w").write("".join(gen))
    consts = [HEADER, "#![allow(dead_code)]\n"]
    for h in ("av1g/enums_gen.h", "av1g/levels_gen.h"):
        for m in re.finditer(r"^#define (AV1G_[A-Z0-9_]+) (-?\d+)\s*$", open(find(h)).read(), re.M):
            consts.append(f"pub const {m.group(1)[5:]}: i32 = {m.group(2)};\n")
    open(os.path.join(OUT, "consts.rs"), "w").write("".join(consts))
    print(f"gen-av1-rust-tables: {len(tabs) + 1} tables, {len(consts) - 2} constants")

main()
