#!/usr/bin/env python3
"""Generates Sources/AV1Core/include/av1g/inter_tables.h: the AV1 spec's tables for inter frames
(default CDFs of the inter syntax, the inverse inter tx-set tables, the sub-pixel filters), copied
from the specification markdown.

    scripts/gen-av1-inter-tables <av1-spec checkout>     # github.com/AOMediaCodec/av1-spec

The intra tables (spec_tables.h, cdf_defaults.h) were generated from the same spec revision by
av1gpu's tools/gen_tables.py; this does the same for the tables inter frames add, in the same
format (AV1G_TABLE, CDFs in spec format: cumulative, 32768, then the adaptation counter 0), so the
Metal kernels can compile them too. Run scripts/gen-av1-rust-tables afterwards.
"""
import os, re, subprocess, sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.path.join(ROOT, "Sources/AV1Core/include/av1g/inter_tables.h")
ENUMS = os.path.join(ROOT, "Sources/AV1Core/include/av1g/enums_gen.h")

# (name, C type, dims, spec file)
TABLES = [
    ("Default_Y_Mode_Cdf", "uint16_t", [4, 14], "10.additional.tables.md"),
    ("Default_Is_Inter_Cdf", "uint16_t", [4, 3], "10.additional.tables.md"),
    ("Default_Single_Ref_Cdf", "uint16_t", [3, 6, 3], "10.additional.tables.md"),
    ("Default_New_Mv_Cdf", "uint16_t", [6, 3], "10.additional.tables.md"),
    ("Default_Zero_Mv_Cdf", "uint16_t", [2, 3], "10.additional.tables.md"),
    ("Default_Ref_Mv_Cdf", "uint16_t", [6, 3], "10.additional.tables.md"),
    ("Default_Drl_Mode_Cdf", "uint16_t", [3, 3], "10.additional.tables.md"),
    ("Default_Txfm_Split_Cdf", "uint16_t", [21, 3], "10.additional.tables.md"),
    ("Default_Mv_Joint_Cdf", "uint16_t", [5], "10.additional.tables.md"),
    ("Default_Mv_Class_Cdf", "uint16_t", [2, 12], "10.additional.tables.md"),
    ("Default_Mv_Class0_Bit_Cdf", "uint16_t", [3], "10.additional.tables.md"),
    ("Default_Mv_Class0_Fr_Cdf", "uint16_t", [2, 2, 5], "10.additional.tables.md"),
    ("Default_Mv_Class0_Hp_Cdf", "uint16_t", [3], "10.additional.tables.md"),
    ("Default_Mv_Fr_Cdf", "uint16_t", [2, 5], "10.additional.tables.md"),
    ("Default_Mv_Hp_Cdf", "uint16_t", [3], "10.additional.tables.md"),
    ("Default_Mv_Sign_Cdf", "uint16_t", [3], "10.additional.tables.md"),
    ("Default_Mv_Bit_Cdf", "uint16_t", [10, 3], "10.additional.tables.md"),
    ("Default_Inter_Tx_Type_Set1_Cdf", "uint16_t", [2, 17], "10.additional.tables.md"),
    ("Default_Inter_Tx_Type_Set2_Cdf", "uint16_t", [13], "10.additional.tables.md"),
    ("Default_Inter_Tx_Type_Set3_Cdf", "uint16_t", [4, 3], "10.additional.tables.md"),
    ("Tx_Type_Inter_Inv_Set1", "uint8_t", [16], "06.bitstream.syntax.md"),
    ("Tx_Type_Inter_Inv_Set2", "uint8_t", [12], "06.bitstream.syntax.md"),
    ("Tx_Type_Inter_Inv_Set3", "uint8_t", [2], "06.bitstream.syntax.md"),
    ("Subpel_Filters", "int16_t", [6, 16, 8], "08.decoding.process.md"),
]


def enums():
    return {m.group(1): int(m.group(2)) for m in re.finditer(r"^#define AV1G_([A-Z0-9_]+) (-?\d+)\s*$", open(ENUMS).read(), re.M)}


def values(text, name, sym):
    m = re.search(r"\b" + name + r"\s*(\[[^=]*\])\s*=\s*\{", text)
    if not m:
        sys.exit(f"gen-av1-inter-tables: {name} not found")
    i, depth = m.end() - 1, 0
    for j in range(i, len(text)):
        depth += {"{": 1, "}": -1}.get(text[j], 0)
        if depth == 0:
            break
    body = re.sub(r"//[^\n]*", "", text[i + 1:j])
    out = []
    for tok in re.split(r"[{},\s]+", body):
        if not tok:
            continue
        expr = re.sub(r"[A-Z_][A-Z0-9_]*", lambda t: str(sym[t.group(0)]), tok)
        if not re.fullmatch(r"[-0-9*+ ]+", expr):
            sys.exit(f"gen-av1-inter-tables: {name}: unexpected token {tok!r}")
        out.append(eval(expr))
    return out


def main():
    if len(sys.argv) != 2:
        sys.exit(__doc__)
    spec = sys.argv[1]
    rev = subprocess.check_output(["git", "-C", spec, "log", "-1", "--format=%H %cd", "--date=short"]).decode().strip()
    sym = enums()
    lines = [
        "// GENERATED by scripts/gen-av1-inter-tables from the AV1 specification markdown",
        f"// (github.com/AOMediaCodec/av1-spec, rev {rev}). DO NOT EDIT.",
        "#ifndef AV1G_INTER_TABLES_H",
        "#define AV1G_INTER_TABLES_H",
        "#include <stdint.h>",
        '#include "av1g/hd.h"',
        "",
        "/* The tables inter frames add: default CDFs in spec format (cumulative, last entry 32768",
        "   followed by the adaptation counter 0), the inverse inter tx sets, the sub-pixel filters. */",
        "",
    ]
    for name, t, dims, f in TABLES:
        v = values(open(os.path.join(spec, f)).read(), name, sym)
        n = 1
        for d in dims:
            n *= d
        if len(v) != n:
            sys.exit(f"gen-av1-inter-tables: {name}: {len(v)} values, expected {n}")
        if t == "uint16_t" and name.endswith("_Cdf"):
            step = dims[-1]
            for k in range(0, n, step):
                c = v[k:k + step]
                if c[-2] != 32768 or c[-1] != 0 or any(a > b for a, b in zip(c[:-2], c[1:-1])):
                    sys.exit(f"gen-av1-inter-tables: {name}: CDF {k // step} is not in spec format")
        d = "".join(f"[{x}]" for x in dims)
        lines.append(f"/* {name} : {f} */")
        lines.append(f"AV1G_TABLE({t}, {name}, {d}, {{{', '.join(map(str, v))}}})")
    lines += ["", "#endif", ""]
    open(OUT, "w").write("\n".join(lines))
    print(f"gen-av1-inter-tables: {len(TABLES)} tables -> {os.path.relpath(OUT, ROOT)}")


main()
