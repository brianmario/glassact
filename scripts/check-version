#!/bin/zsh
# The version in Apps/Version.xcconfig and the glassact CLI must agree, and a
# release tag (vX.Y.Z), if given, must name that version.
#
#   scripts/check-version            # the two sources agree
#   scripts/check-version v0.2.0     # …and match this tag
set -euo pipefail
cd "${0:A:h}/.."
app=$(sed -n 's/^GLASSACT_VERSION *= *\([0-9.]*\).*/\1/p' Apps/Version.xcconfig)
cli=$(sed -n 's/^let version = "\([0-9.]*\)".*/\1/p' Sources/glassact/main.swift)
[[ -n $app && -n $cli ]] || { echo "✗ couldn't read the version"; exit 1; }
[[ $app =~ '^[0-9]+\.[0-9]+\.[0-9]+$' ]] || { echo "✗ GLASSACT_VERSION $app isn't X.Y.Z"; exit 1; }
[[ $app == $cli ]] || { echo "✗ Apps/Version.xcconfig says $app, the CLI says $cli"; exit 1; }
if (( $# > 0 )); then
	[[ $1 == "v$app" ]] || { echo "✗ tag $1 doesn't match version $app (expected v$app)"; exit 1; }
fi
echo "✓ version $app"
