#!/bin/zsh
# Vendor libaom into ThirdParty/libaom (see ThirdParty/THIRD_PARTY.md).
#
#   scripts/vendor-libaom <libaom checkout>
#
# Configures the checkout the way Glass Act builds it (arm64 NEON only,
# realtime-only encoder, 8-bit, decoder for tests, no runtime CPU
# detection), builds libaom.a to prove the configuration, then copies exactly
# the sources that library compiles and the files they include. Generated
# files go in ThirdParty/libaom/glassact:
#   config/       aom_config.h, the *_rtcd.h dispatch headers, aom_version.h
#   wrappers/     one file per source, compiling it on arm64 only, so the
#                 Intel slice of a universal build carries no libaom
# glassact/include and glassact/shim (the C API Swift uses) are ours and are
# left alone.
set -euo pipefail

SRC=${1:?usage: scripts/vendor-libaom <libaom checkout>}
SRC=${SRC:A}
ROOT=${0:A:h:h}
DEST=$ROOT/ThirdParty/libaom
BUILD=$(mktemp -d)
trap 'rm -rf $BUILD' EXIT

COMMIT=$(git -C $SRC rev-parse HEAD)
echo "▸ libaom $COMMIT"
cmake -S $SRC -B $BUILD -DCMAKE_BUILD_TYPE=Release -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
	-DCMAKE_OSX_ARCHITECTURES=arm64 \
	-DCONFIG_RUNTIME_CPU_DETECT=0 -DENABLE_ARM_CRC32=0 -DENABLE_NEON_DOTPROD=0 \
	-DENABLE_NEON_I8MM=0 -DENABLE_SVE=0 -DENABLE_SVE2=0 \
	-DCONFIG_REALTIME_ONLY=1 -DCONFIG_AV1_HIGHBITDEPTH=0 \
	-DCONFIG_AV1_ENCODER=1 -DCONFIG_AV1_DECODER=1 \
	-DENABLE_TESTS=0 -DENABLE_TOOLS=0 -DENABLE_EXAMPLES=0 -DENABLE_DOCS=0 \
	-DCONFIG_WEBM_IO=0 -DCONFIG_LIBYUV=0 -DCONFIG_TUNE_VMAF=0 \
	-DCONFIG_TUNE_BUTTERAUGLI=0 -DCONFIG_SALIENCY_MAP=0 >$BUILD/cmake.log
echo "▸ building libaom.a"
make -C $BUILD -j$(sysctl -n hw.ncpu) aom >$BUILD/make.log

echo "▸ copying sources and the files they include"
find $DEST -mindepth 1 -maxdepth 1 ! -name glassact -exec rm -rf {} +
rm -rf $DEST/glassact/config $DEST/glassact/wrappers
python3 -I - $SRC $BUILD $DEST $COMMIT <<'PY'
import json, os, shlex, shutil, subprocess, sys
src, build, dest, commit = sys.argv[1:5]
objects = set(subprocess.run(['ar', 't', f'{build}/libaom.a'],
                             capture_output=True, text=True, check=True).stdout.split())
sources, generated, headers = [], [], set()
for entry in json.load(open(f'{build}/compile_commands.json')):
    if os.path.basename(entry['output']) not in objects:
        continue
    path = os.path.realpath(entry['file'])
    if path.startswith(os.path.realpath(src) + '/'):
        sources.append(os.path.relpath(path, os.path.realpath(src)))
    elif os.path.basename(path) == 'aom_config.c':
        generated.append(path)
    else:
        continue  # the no-op translation units
    # The headers this file includes, with its own flags.
    args = [a for a in shlex.split(entry['command'])[1:]]
    out = args.index('-o')
    del args[out:out + 2]
    args.remove('-c')
    deps = subprocess.run(['cc', '-MM', *args], capture_output=True, text=True, check=True,
                          cwd=entry['directory']).stdout
    for dep in deps.replace('\\\n', ' ').split()[1:]:
        dep = os.path.realpath(os.path.join(entry['directory'], dep))
        if dep != path and dep.startswith(os.path.realpath(src) + '/'):
            headers.add(os.path.relpath(dep, os.path.realpath(src)))
sources = sorted(set(sources))
for rel in sources + sorted(headers) + ['LICENSE', 'PATENTS', 'AUTHORS']:
    os.makedirs(os.path.dirname(os.path.join(dest, rel)) or dest, exist_ok=True)
    shutil.copy2(os.path.join(src, rel), os.path.join(dest, rel))
config = os.path.join(dest, 'glassact', 'config')
os.makedirs(config)
for name in ['aom_config.h', 'aom_dsp_rtcd.h', 'aom_scale_rtcd.h', 'av1_rtcd.h', 'aom_version.h']:
    shutil.copy2(os.path.join(build, 'config', name), config)
shutil.copy2(generated[0], config)
wrappers = os.path.join(dest, 'glassact', 'wrappers')
os.makedirs(wrappers)
for rel in sources + ['glassact/config/aom_config.c']:
    name = rel.replace('/', '__')
    with open(os.path.join(wrappers, name), 'w') as f:
        f.write(f'// Generated by scripts/vendor-libaom: {rel}, arm64 only.\n'
                f'#if defined(__aarch64__)\n#include "../../{rel}"\n#endif\n')
with open(os.path.join(dest, 'glassact', 'COMMIT'), 'w') as f:
    f.write(commit + '\n')
print(f'  {len(sources)} sources, {len(headers)} included files, libaom {commit[:12]}')
PY
echo "✓ ThirdParty/libaom — record the commit in ThirdParty/THIRD_PARTY.md and run swift test"
